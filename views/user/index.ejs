											<button class="add-to-cart">Add To Cart</button>
										</figure>
										<figcaption>
											<h3><%= product.title %></h3>
											<span><%= product.author %></span>
											<div class="item-price">₹<%= product.price %></div>
										</figcaption>
									</div>
								</div>
							<% }) %>
						</div>


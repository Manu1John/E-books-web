<% 
	// Stateful URL helper: captures query parameters, the current target hash, and active tab identity
	function getPageUrl(paramName, paramValue, anchor, tabId) {
		let params = new URLSearchParams(query || {});
		params.set(paramName, paramValue);
		if (tabId) {
			params.set('activeTab', tabId);
		}
		return "?" + params.toString() + (anchor ? anchor : '');
	}

	// Read state tracker to decide which active display layout classes to apply
	let activeTabId = (typeof query !== 'undefined' && query.activeTab) ? query.activeTab : 'all-books';
%>


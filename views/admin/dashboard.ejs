<%- include('../partials/header') %>
<div class="container">

    <!-- Sidebar -->
    <aside class="sidebar">

        <h1 class="logo">Admin Panel</h1>

        <ul class="menu">
            <li><a href="#">Dashboard</a></li>
            <li><a href="#">Reports</a></li>
            <li><a href="#">Products</a></li>
            <li><a href="#">Orders</a></li>
            <li><a href="#">Offers</a></li>
            <li><a href="#">Categories</a></li>

        </ul>

    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Top Navbar -->
        <div class="top-bar">

<form
    action="/admin/dashboard"
    method="GET"
    id="searchForm"
>

    <div class="search-box">

        <i class="fa fa-search"></i>

        <input
            type="text"
            id="searchInput"
            name="search"
            placeholder="Search by email..."
            value="<%= search || '' %>"
        >

        <% if(search){ %>

            <button
                type="button"
                id="clearSearch"
                class="clear-btn"
            >
                ✖
            </button>

        <% } %>

    </div>

</form>
            <form
                action="/admin/logout"
                method="POST"
            >
                <button class="logout-btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </button>
            </form>

        </div>

        <h2 class="page-title">
            Users
        </h2>
        <h5 class="page-users-count">Total users:  <%= totalUsers %></h5>
<!-- 
        <div class="wallet-wrapper">
            <button class="wallet-btn">
                Go to Wallet
            </button>
        </div> -->

        <!-- Table -->
        <div class="table-container">

            <table>

                <thead>
                    <tr>
                        <th>No</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <%users.forEach((user,index)=>{%>
                    <tr>
                        <td><%= ((currentPage - 1) * 5) + index + 1 %></td>
                        <td><%=user.firstName%></td>
                        <td><%=user.lastName%></td>
                        <td><%=user.email%></td>
                        <td>
                            <span class="status active">
                            <%= user.isBlocked ? "Blocked" : "Active" %>
                            </span>
                        </td>
                        <td>
                            <%if(user.isBlocked){%>
                                <a href="/admin/unblock-user/<%=user.id%>"  >
                                    
                            <button class="block-btn" onclick="return confirm('Are you sure you want to unblock this user?')">
                                Unblock
                            </button>
                            </a>
                            <%}else{%>
                            <a href="/admin/block-user/<%=user.id%>" >
                                  
                            <button class="block-btn" onclick="return confirm('Are you sure you want to block this user?')">
                                block
                            </button>
                            </a>
                            <%}%>
                        </td>
                    </tr>

                   
                    </tr>
                    <%})%>
                    
                </tbody>

            </table>
            <div class="pagination">

    <% if(currentPage > 1){ %>

        <a href="/admin/dashboard?page=<%= currentPage - 1 %>&search=<%= search %>">
            Previous
        </a>

    <% } %>

    <% for(let i = 1; i <= totalPages; i++){ %>

        <a
        href="/admin/dashboard?page=<%= i %>&search=<%= search %>"
        >
            <%= i %>
        </a>

    <% } %>

    <% if(currentPage < totalPages){ %>

<a href="/admin/dashboard?page=<%= currentPage + 1 %>&search=<%= search %>">
            Next
        </a>

    <% } %>

</div>

        </div>

    </main>

</div>
<%- include('../partials/footer') %>



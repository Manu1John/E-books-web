
<%- include('../partials/header') %>

<div class="container">

    <!-- Sidebar -->
    <aside class="sidebar">

        <h1 class="logo">
            Admin Panel
        </h1>

        <ul class="menu">
            <li>
                <a href="/admin/users">
                    Users
                </a>
            </li>

            <li><a href="#">Reports</a></li>
            <li><a href="/admin/products">Products</a></li>
            <li><a href="#">Orders</a></li>
            <li><a href="#">Offers</a></li>
            <li><a href="#">Coupons</a></li>

            <li>
                <a href="/admin/category">
                    Categories
                </a>
            </li>
        </ul>

    </aside>


    <!-- Main Content -->
    <main class="main-content">

        <!-- Top Navbar -->
        <div class="top-bar">

            <!-- Search -->
            <form
                action="/admin/category"
                method="GET"
            >

                <div class="search-box">

                    <i class="fa fa-search"></i>

                    <input
                        type="text"
                        id="searchInput"
                        name="search"
                        placeholder="Search by Category"
                        value="<%= search || '' %>"
                    >

                    <% if(search) { %>

                        <button
                            type="button"
                            class="clear-btn"
                            onclick="window.location.href='/admin/category'"
                        >
                            ✖
                        </button>

                    <% } %>

                </div>

            </form>


            <!-- Logout -->
            <form
                action="/admin/logout"
                method="POST"
            >
                <button
                    class="logout-btn"
                    type="submit"
                >
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </button>
            </form>

        </div>


        <!-- Add Category -->
        <form
            action="/admin/category/add"
            method="GET"
        >
            <button
                type="submit"
                class="addCategory-btn"
                 id="openCategoryModal"
            >
                Add Category
            </button>
        </form>


        <h2 class="page-title">
            Categories
        </h2>

        <h5 class="page-users-count">
            Total Categories:
            <%= totalCategories %>
        </h5>


        <!-- Table -->
        <div class="table-container">

            <table>

                <thead>
                    <tr>
                        <th>No</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <% if(cat.length > 0) { %>

                        <% cat.forEach((category, index) => { %>

                            <tr>

                                <td>
                                    <%= (currentPage - 1) * 4 + index + 1 %>
                                </td>

                                <td>
                                    <%= category.name %>
                                </td>

                                <td>
                                    <%= category.description %>
                                </td>

                                <td>
                                    <%= category.status %>
                                </td>

                                <td class="action-buttons">

                                    <!-- Edit -->
                                    <a
                                        href="/admin/category/<%= category._id %>/edit"
                                        class="editCategory-btn"
                                    >
                                        Edit
                                    </a>

                                    <!-- Delete -->
<button
    type="button"
    class="delete-btn"
    onclick="deleteCategory('<%= category._id%>')"
>
    Delete
</button>

<script>
window.deleteCategory = async function(categoryId) {

    const isConfirmed = confirm(
        "Are you sure you want to delete this category?"
    );

    if (!isConfirmed) return;

    try {

        const response = await fetch(
            `/admin/category/${categoryId}/delete`,
            {
                method: "DELETE",
                headers: {
                    "Content-Type": "application/json"
                }
            }
        );

        const data = await response.json();

        if (response.ok && data.success) {

            alert("Category deleted successfully!");
            location.reload();

        } else {

            alert(data.message || "Failed to delete category.");

        }

    } catch (error) {

        console.error("Error deleting category:", error);
        alert("Something went wrong. Check console for details.");

    }
};
</script>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>
                            <td
                                colspan="5"
                                style="text-align:center;"
                            >
                                No categories found
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>


        <!-- Pagination -->
        <% if(totalPages > 1) { %>

            <div class="pagination">

                <!-- Previous -->
                <% if(currentPage > 1) { %>

                    <a
                        href="/admin/category?page=<%= currentPage - 1 %>&search=<%= search || '' %>"
                        class="page-btn"
                    >
                        Previous
                    </a>

                <% } %>


                <!-- Page Numbers -->
                <% for(let i = 1; i <= totalPages; i++) { %>

                    <a
                        href="/admin/category?page=<%= i %>&search=<%= search || '' %>"
                        class="
                            page-btn
                            <%= currentPage === i ? 'active-page' : '' %>
                        "
                    >
                        <%= i %>
                    </a>

                <% } %>


                <!-- Next -->
                <% if(currentPage < totalPages) { %>

                    <a
                        href="/admin/category?page=<%= currentPage + 1 %>&search=<%= search || '' %>"
                        class="page-btn"
                    >
                        Next
                    </a>

                <% } %>

            </div>

        <% } %>

    </main>

</div>

<%- include('../partials/footer') %>

